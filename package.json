{
  "name": "chat-with-pdf-workspace",
  "version": "1.0.0",
  "private": true,
  "description": "Workspace for the Angular frontend and Express backend of Chat with PDF",
  "scripts": {
    "install:all": "npm install --prefix backend && npm install --prefix frontend",
    "dev:backend": "npm --prefix backend run dev",
    "dev:frontend": "npm --prefix frontend run start",
    "dev": "concurrently -n backend,frontend -c blue,green \"npm:dev:backend\" \"npm:dev:frontend\"",
    "build": "npm --prefix frontend run build",
    "build:backend": "npm --prefix backend install --production",
    "start": "npm --prefix backend run start",
    "start:prod": "npm run build && npm start"
  },
  "devDependencies": {
    "concurrently": "^9.0.0"
  }
}
